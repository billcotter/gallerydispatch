---
import { getFilmPosterSources } from "../lib/film";

interface Props {
  slug: string;
  title: string;
  year: number;
  poster_path: string | null;
  tmdb_rating: number | null;
}

const { slug, title, year, poster_path, tmdb_rating } = Astro.props;
const poster = getFilmPosterSources(poster_path);
const rating =
  tmdb_rating != null && Number.isFinite(tmdb_rating)
    ? (Math.round(tmdb_rating * 10) / 10).toFixed(1)
    : null;
---

<li class="film-card-test">
  <a href={`/movies/${slug}/`}>
    {
      poster ? (
        <span class="poster">
          <img
            src={poster.src}
            srcset={poster.srcset}
            sizes="280px"
            width="342"
            height="513"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </span>
      ) : (
        <span class="poster poster-fallback" aria-hidden="true">
          <span class="poster-fallback-copy">
            <span class="poster-fallback-title">{title}</span>
            <span>Poster unavailable</span>
          </span>
        </span>
      )
    }
    <span class="content">
      <span class="title">{title}</span>
      <span class="meta">{year}</span>
      {
        rating ? (
          <span class="rating">
            <span class="rating-star" aria-hidden="true">★</span>
            <span class="rating-value">{rating}</span>
          </span>
        ) : null
      }
      <span class="read-more">
        <span>Read more</span>
        <span class="read-more-arrow" aria-hidden="true">→</span>
      </span>
    </span>
  </a>
</li>

<style>
  .film-card-test {
    min-width: 0;
    max-width: 17.5rem;
  }

  .film-card-test a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    height: auto;
    color: var(--color-text);
    text-decoration: none;
  }

  .film-card-test a:hover {
    text-decoration: none;
  }

  .film-card-test a:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 0.12em;
  }

  .poster {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio-portrait);
    overflow: hidden;
    background: var(--color-surface);
  }

  .poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .poster-fallback {
    display: flex;
    align-items: flex-end;
    padding: var(--space-2);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }

  .poster-fallback-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--step-0);
    line-height: 1.4;
  }

  .poster-fallback-title {
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    width: 100%;
    min-width: 0;
    height: auto;
    background: var(--color-surface);
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .meta {
    font-size: var(--step-0);
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .rating,
  .read-more {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    width: fit-content;
    gap: var(--space-1);
  }

  .rating-star {
    font-size: 0.875rem;
    line-height: 1.2;
  }

  .rating-value,
  .read-more {
    font-size: var(--step-0);
    font-weight: 400;
    line-height: 1.2;
  }

  .read-more-arrow {
    font-size: var(--step-1);
    line-height: 1.2;
  }
</style>
