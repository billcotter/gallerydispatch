---
import { getFilmCardId, getFilmPosterSources } from "../lib/film";

interface Props {
  slug: string;
  title: string;
  year: number;
  poster_path: string | null;
}

const { slug, title, year, poster_path } = Astro.props;
const poster = getFilmPosterSources(poster_path);
const cardId = getFilmCardId(slug);
---

<li class="film-card" id={cardId}>
  <a href={`/movies/${slug}/`}>
    {
      poster ? (
        <span class="film-card-poster">
          <img
            src={poster.src}
            srcset={poster.srcset}
            sizes="(max-width: 28rem) 16rem, (max-width: 60rem) 22vw, 185px"
            width="342"
            height="513"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </span>
      ) : (
        <span class="film-card-poster" aria-hidden="true">
          <span class="film-card-fallback"></span>
        </span>
      )
    }
    <span class="film-card-copy">
      <span class="film-card-title">{title}</span>
      <span class="film-card-year">{year}</span>
    </span>
  </a>
</li>

<style>
  .film-card {
    min-width: 0;
    scroll-margin-top: var(--space-4);
  }

  .film-card a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-2);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .film-card a:hover {
    text-decoration: none;
  }

  .film-card a:hover .film-card-title {
    text-decoration: underline;
    text-decoration-thickness: 0.12em;
  }

  .film-card-poster {
    display: block;
    position: relative;
    aspect-ratio: var(--ratio-portrait);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .film-card-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .film-card-fallback {
    position: absolute;
    inset: 0;
    background-color: var(--color-surface);
  }

  .film-card-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .film-card-title {
    font-weight: 650;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .film-card-year {
    color: var(--color-text-muted);
  }
</style>
