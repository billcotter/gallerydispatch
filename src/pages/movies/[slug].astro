---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatAudienceRating,
  formatJoinedList,
  formatReleaseDate,
  formatRuntime,
  getFilmCardHref,
  getFilmCardReturnLabel,
  getFilmPosterSources,
  getFilmStaticPaths,
  getImdbUrl,
  getTmdbFilmUrl,
  shouldShowOriginalTitle,
} from "../../lib/film";

export function getStaticPaths() {
  return getFilmStaticPaths();
}

const { movie } = Astro.props;
const poster = getFilmPosterSources(movie.poster_path, { srcSize: "w500" });
const originalTitle = shouldShowOriginalTitle(movie.title, movie.original_title)
  ? movie.original_title
  : null;
const runtime = formatRuntime(movie.runtime);
const released = formatReleaseDate(movie.release_date);
const genres = formatJoinedList(movie.genres);
const countries = formatJoinedList(movie.production_countries);
const languages = formatJoinedList(movie.spoken_languages);
const hasDescriptive = Boolean(
  runtime || released || genres || countries || languages,
);
const reception = formatAudienceRating(movie.tmdb_rating, movie.tmdb_vote_count);
const tmdbUrl = getTmdbFilmUrl(movie.tmdb_id);
const imdbUrl = getImdbUrl(movie.imdb_id);
const cardHref = getFilmCardHref(movie.slug);
const cardReturnLabel = getFilmCardReturnLabel(movie.title);
const description =
  movie.overview ?? `${movie.title} (${movie.year}) in the Film collection.`;
---

<BaseLayout title={`${movie.title} (${movie.year})`} description={description}>
  <nav class="film-breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="/movies/">Film</a></li>
      <li>
        <span aria-current="page">{movie.title}</span>
      </li>
    </ol>
  </nav>

  <div class="film-detail">
    {
      poster ? (
        <div class="film-poster">
          <img
            src={poster.src}
            srcset={poster.srcset}
            sizes="(min-width: 40rem) 12rem, min(70vw, 20rem)"
            width="500"
            height="750"
            alt=""
            loading="eager"
            decoding="async"
          />
        </div>
      ) : (
        <div class="film-poster" aria-hidden="true">
          <span class="film-poster-fallback"></span>
        </div>
      )
    }

    <div class="film-body">
      <div class="film-identity">
        <h1>{movie.title}</h1>
        {originalTitle ? <p class="film-original">{originalTitle}</p> : null}
        <p class="film-year">{movie.year}</p>
      </div>
      {movie.overview ? <p class="film-overview">{movie.overview}</p> : null}

      {
        hasDescriptive ? (
          <dl class="film-meta">
            {runtime ? (
              <div>
                <dt>Runtime</dt>
                <dd>{runtime}</dd>
              </div>
            ) : null}
            {released ? (
              <div>
                <dt>Released</dt>
                <dd>{released}</dd>
              </div>
            ) : null}
            {genres ? (
              <div>
                <dt>Genres</dt>
                <dd>{genres}</dd>
              </div>
            ) : null}
            {countries ? (
              <div>
                <dt>Countries</dt>
                <dd>{countries}</dd>
              </div>
            ) : null}
            {languages ? (
              <div>
                <dt>Languages</dt>
                <dd>{languages}</dd>
              </div>
            ) : null}
          </dl>
        ) : null
      }

      {
        reception ? (
          <section class="film-reception">
            <h2>External reception</h2>
            <p>
              <span class="film-reception-source">TMDB audience rating</span>
              {reception.statement}
            </p>
          </section>
        ) : null
      }

      <section class="film-sources">
        <h2>Sources</h2>
        <ul>
          <li>
            <a href={tmdbUrl}>View on TMDB</a>
          </li>
          {
            imdbUrl ? (
              <li>
                <a href={imdbUrl}>View on IMDb</a>
              </li>
            ) : null
          }
        </ul>
      </section>
    </div>
  </div>

  <p class="film-nav-links">
    <a href={cardHref}>
      <span aria-hidden="true">← </span>
      {cardReturnLabel}
    </a>
    <span class="film-nav-sep" aria-hidden="true">·</span>
    <a href="#top">Back to top</a>
  </p>
</BaseLayout>

<style>
  .film-breadcrumb {
    margin-bottom: var(--space-4);
  }

  .film-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
    color: var(--color-text-muted);
  }

  .film-breadcrumb li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
  }

  .film-breadcrumb li + li::before {
    content: ">";
    color: var(--color-text-muted);
  }

  .film-breadcrumb [aria-current="page"] {
    color: var(--color-text);
  }

  .film-nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: baseline;
    margin-top: var(--space-5);
  }

  .film-nav-sep {
    color: var(--color-text-muted);
  }

  @media (max-width: 27.99rem) {
    .film-nav-links {
      flex-direction: column;
      align-items: flex-start;
    }

    .film-nav-sep {
      display: none;
    }
  }

  .film-detail {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
  }

  .film-poster {
    position: relative;
    width: min(12rem, 100%);
    aspect-ratio: var(--ratio-portrait);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .film-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .film-poster-fallback {
    position: absolute;
    inset: 0;
    background-color: var(--color-surface);
  }

  .film-body {
    min-width: 0;
    width: 100%;
  }

  .film-identity {
    text-align: center;
  }

  .film-identity h1 {
    overflow-wrap: anywhere;
  }

  .film-original {
    color: var(--color-text-muted);
    font-size: var(--step-1);
  }

  .film-year {
    color: var(--color-text-muted);
  }

  .film-overview {
    margin-top: var(--space-3);
    text-align: start;
  }

  .film-meta {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    text-align: start;
  }

  .film-meta div {
    display: grid;
    gap: var(--space-1);
  }

  .film-meta dt {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .film-meta dd {
    margin: 0;
  }

  .film-reception-source {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .film-sources ul {
    padding-left: 1.25rem;
  }

  @media (min-width: 40rem) {
    .film-detail {
      grid-template-columns: 12rem minmax(0, 1fr);
      justify-items: stretch;
      align-items: start;
    }

    .film-identity {
      text-align: start;
    }
  }
</style>
