---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  layout?: "article" | "collection";
}

const { title, description, layout = "article" } = Astro.props;
const pageTitle =
  title === "Cultural Archive" ? title : `${title} · Cultural Archive`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page-shell" id="top" data-layout={layout}>
      <SiteHeader />
      <main id="main-content" tabindex="-1" class="page-main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
